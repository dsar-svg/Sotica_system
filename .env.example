SOTICA_DATABASE_URL=postgresql://sotica:sotica@localhost:5432/sotica
SOTICA_STORAGE_DIR=./storage
SOTICA_PUBLIC_BASE_URL=http://localhost:8000
# Modelo de Claude usado por ORQ-COST y los subagentes.
SOTICA_MODEL=claude-opus-5-5
# En desarrollo puede quedar vacía: el SDK usa la sesión de Claude Code de esta máquina.
# En el servidor del cliente es obligatoria.
ANTHROPIC_API_KEY=
# Solo Windows: ruta a un claude.exe nativo (el claude.cmd de npm no sirve).
SOTICA_CLAUDE_CLI=
